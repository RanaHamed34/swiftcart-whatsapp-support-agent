    {
      "parameters": {
        "jsCode": "const req = $('Webhook').first().json.body || {};\nconst ticket = $input.all().map(i => i.json).find(t => t.ticket_id);\nconst valid = [\"Open\", \"In Progress\", \"Resolved\"];\n\nlet ok = true;\nlet message = \"Ticket updated\";\nif (!req.ticket_id) { ok = false; message = \"No ticket_id in the request\"; }\nelse if (!ticket) { ok = false; message = \"Ticket \" + req.ticket_id + \" not found in the sheet\"; }\nelse if (!valid.includes(req.status)) { ok = false; message = \"Status must be Open, In Progress or Resolved. Received: \" + req.status; }\nelse if (req.status === \"Resolved\" && !req.resolution) { ok = false; message = \"A resolution is required for a Resolved ticket\"; }\n\nreturn [{ json: {\n  ok, ticket_id: req.ticket_id, status: req.status, resolution: req.resolution || \"\",\n  resolved_date: req.status === \"Resolved\" ? $now.toFormat(\"yyyy-MM-dd HH:mm\") : \"\",\n  message\n} }];"
      },
